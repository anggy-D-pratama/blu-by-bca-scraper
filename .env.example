# Account and bank selection
# ACCOUNT_NUMBER can also be passed as the first CLI argument.
ACCOUNT_NUMBER=
# BANKCODE can also be passed as the second CLI argument; defaults to "blu".
BANKCODE=blu

# Backend API used by the scraper
CORE_XYZ_API=https://api.example.test
API_KEY=your-api-key
SECRET_KEY=your-secret-key

# Set to true to use the in-code mock API responses instead of backend responses.
USE_API_MOCK=false

# Mock bank-account response values; only used when USE_API_MOCK=true.
DEVICE_CODE=
ACCOUNT_PASSWORD=
ACCOUNT_SAFE_KEY=

# Optional Telegram destination for mock-mode Telegram interception.
DEV_TELEGRAM_BOT_TOKEN=
DEV_TELEGRAM_CHAT_ID=
